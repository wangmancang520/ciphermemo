{
  "name": "ciphermemo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "cf:deploy": "wrangler deploy",
    "setup:local": "node scripts/setup-local.mjs",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts vitest.config.ts wrangler.jsonc .github README.md .prettierrc.json index.html",
    "deploy:local": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "hash-wasm": "^4.12.0",
    "hono": "^4.10.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "marked": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "miniflare": "5.20261019.1-beta",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "自动创建私人空间的 D1 数据库，仅保存内容密文和必要索引。"
      },
      "FILES": {
        "description": "自动创建私有 R2 存储桶，用于保存加密图片和文件；请先在 Cloudflare 账号中启用 R2。"
      },
      "SETUP_TOKEN": {
        "description": "请填写至少 32 个字符的独立随机初始化口令。部署后首次打开网站时需要输入它；它不是你的登录密码。请勿使用示例值或将真实口令提交到 GitHub。"
      }
    }
  }
}
